{
  "experiment": {
    "name": "sade_dynamic_cec_50d100d_25runs",
    "algorithms": ["sade", "sade_dynamic", "dsi"],
    "suites": ["cec2017"],
    "problems": ["c01", "c02", "c04", "c05", "c13", "c20", "c22"],
