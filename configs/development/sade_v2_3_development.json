{
  "experiment": {
    "name": "sade_v2_3_development",
    "algorithms": ["sade_v2_3"],
    "suites": ["cec2017"],
    "problems": ["c01", "c05", "c20", "c22"],
    "dimensions": [10, 30],
    "runs": 3,
    "first_seed": 1
  },
  "common": {
    "max_evaluations": 300,
    "population_size": 30,
    "constraint_tolerance": 0.0
  },
  "algorithms": {
    "sade_v2_3": {
      "batch_size": 3,
      "trials_per_target": 6,
      "local_fraction": 0.2,
      "surrogate_min_samples": 30,
      "p_best_fraction": 0.2,
      "distance_threshold": 0.001,
      "near_feasible_fraction": 0.2,
      "constraint_error_quantile": 0.9,
      "constraint_error_window": 30,
      "constraint_error_min_samples": 12,
      "constraint_safety_factor": 1.0
    }
  },
  "recording": {
    "save_evaluations": true,
    "save_populations": true,
    "save_candidate_pools": false
  }
}
