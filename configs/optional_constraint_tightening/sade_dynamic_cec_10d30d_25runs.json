    "suites": ["cec2006", "cec2010", "cec2017"],
    "problems": ["all"],
    "dimensions": [10, 30],
    "runs": 25,
    "first_seed": 1
  },
  "common": {
    "max_evaluations": 300,
    "population_size": 30,
    "constraint_tolerance": 0.0
